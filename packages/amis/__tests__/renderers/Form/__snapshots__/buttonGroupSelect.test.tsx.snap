                </span>
              </span>
            </span>
          </label>
          <div
            class="__AMIS_COMPONENT_CLASS_PREFIX__ButtonGroup __AMIS_COMPONENT_CLASS_PREFIX__Form-control"
          >
            <button
              class="__AMIS_COMPONENT_CLASS_PREFIX__Button __AMIS_COMPONENT_CLASS_PREFIX__Button--warning __AMIS_COMPONENT_CLASS_PREFIX__Button--size-default __AMIS_COMPONENT_CLASS_PREFIX__ButtonGroup-button--active"
              type="button"
            >
              <span>
                Option A
              </span>
            </button>
            <button
              class="__AMIS_COMPONENT_CLASS_PREFIX__Button __AMIS_COMPONENT_CLASS_PREFIX__Button--primary __AMIS_COMPONENT_CLASS_PREFIX__Button--size-default"
              type="button"
            >
              <span>
                Option B
              </span>
            </button>
            <button
              class="__AMIS_COMPONENT_CLASS_PREFIX__Button __AMIS_COMPONENT_CLASS_PREFIX__Button--light __AMIS_COMPONENT_CLASS_PREFIX__Button--size-default"
              type="button"
            >
              <span>
                Option C
              </span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
`;

